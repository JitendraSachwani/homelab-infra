gerbil:
    start_port: 51820
    base_endpoint: "{{ pangolin_dashboard_domain }}"

app:
    dashboard_url: "{{ pangolin_dashboard_url }}"
    log_level: "info"
    telemetry:
        anonymous_usage: false

domains:
    domain1:
        base_domain: "{{ pangolin_base_domain }}"

server:
    secret: "{{ pangolin_server_secret }}"
    cors:
        origins: ["{{ pangolin_dashboard_url }}"]
        methods: ["GET", "POST", "PUT", "DELETE", "PATCH"]
        allowed_headers: ["X-CSRF-Token", "Content-Type"]
        credentials: false

flags:
    require_email_verification: {{ pangolin_require_email_verification | bool | lower }}
    disable_signup_without_invite: {{ pangolin_disable_signup_without_invite | bool | lower }}
    disable_user_create_org: {{ pangolin_disable_user_create_org | bool | lower }}
    allow_raw_resources: {{ pangolin_allow_raw_resources | bool | lower }}
